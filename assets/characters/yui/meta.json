   "zh": "在飞哦——！在飞哦——！"
  },
  "yui-39.mp3": {
   "ja": "はーい！もっとやって！もっとやって！",
   "zh": "好耶！再来一次！再来一次！"
  },
  "yui-40.mp3": {
