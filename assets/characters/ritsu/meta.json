  "ritu-24.mp3": {
   "ja": "うっわー！",
   "zh": "哇啊——！"
  },
  "ritu-25.mp3": {
   "ja": "なんだよ！",
   "zh": "干嘛啦！"
  },
  "ritu-26.mp3": {
   "ja": "よっ！",
   "zh": "哟！"
  },
  "ritu-27.mp3": {
   "ja": "リッちゃんです！",
   "zh": "我是小律！"
  },
  "ritu-28.mp3": {
   "ja": "なに？",
   "zh": "什么？"
  },
  "ritu-29.mp3": {
   "ja": "遊ぶのか？",
   "zh": "要玩吗？"
  },
  "ritu-30.mp3": {
   "ja": "お腹減った",
   "zh": "肚子饿了"
  },
  "ritu-31.mp3": {
   "ja": "私だよ！",
   "zh": "是我啦！"
  },
  "ritu-32.mp3": {
   "ja": "（怪腔）",
   "zh": "何方妖孽——"
  },
  "ritu-33.mp3": {
