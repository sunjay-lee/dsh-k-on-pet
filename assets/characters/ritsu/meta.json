   "zh": "最喜欢轻音了！"
  },
  "ritu-39.mp3": {
   "ja": "やーめーろー！",
   "zh": "住——手——！"
  },
  "ritu-40.mp3": {
   "ja": "（怪叫）",
   "zh": "呜哇！"
  },
  "ritu-41.mp3": {
   "ja": "（怪叫）",
   "zh": "嘿——！"
  },
  "ritu-42.mp3": {
   "ja": "もえもえきゅん！",
   "zh": "萌啊萌啊～啾！"
  },
  "ritu-43.mp3": {
