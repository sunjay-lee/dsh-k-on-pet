 "lines": {
  "azusa-01.mp3": {
   "ja": "おはようございます",
   "zh": "早上好"
  },
  "azusa-24.mp3": {
   "ja": "うわー！びっくりした",
   "zh": "哇！吓我一跳"
  },
  "azusa-25.mp3": {
   "ja": "ちょっちょっちょっ…ストップ！ストップです！",
   "zh": "等等等等…停下！快停下！"
  },
  "azusa-26.mp3": {
   "ja": "え、いや、別にいいんですけどね",
   "zh": "呃，不，倒也没什么…"
  },
  "azusa-27.mp3": {
   "ja": "（怪叫）",
   "zh": "呜哇——"
  },
  "azusa-28.mp3": {
   "ja": "ふざけないでください",
   "zh": "请别闹了"
  },
  "azusa-29.mp3": {
   "ja": "嫌です！",
   "zh": "不要！"
  },
  "azusa-30.mp3": {
   "ja": "もうちょっと後にしてください",
   "zh": "请再晚一点"
  },
  "azusa-31.mp3": {
   "ja": "えっと、そろそろいいですよ",
   "zh": "那个，差不多可以了"
  },
  "azusa-32.mp3": {
   "ja": "（含糊）",
   "zh": "什么？"
  },
  "azusa-33.mp3": {
   "ja": "もっと遊んでください！",
   "zh": "请多陪我玩！"
  },
  "azusa-34.mp3": {
   "ja": "特別ですよ",
   "zh": "特别优待哦"
  },
  "azusa-35.mp3": {
   "ja": "マシュマロ",
   "zh": "棉花糖"
  },
  "azusa-36.mp3": {
   "ja": "ちょっとだけですよ",
   "zh": "只一点点哦"
  },
  "azusa-37.mp3": {
   "ja": "ダメですよ！",
   "zh": "不行的！"
  },
  "azusa-38.mp3": {
   "ja": "まだやるんですか？",
   "zh": "还要来吗？"
  },
  "azusa-39.mp3": {
   "ja": "にゃん！",
   "zh": "喵！"
  },
  "azusa-40.mp3": {
   "ja": "でも、嫌いじゃないです",
   "zh": "不过，我也不讨厌"
  },
  "azusa-41.mp3": {
   "ja": "降りていいですか？",
   "zh": "可以下来吗？"
  },
  "azusa-42.mp3": {
   "ja": "おろしてください",
   "zh": "请放我下来"
  },
  "azusa-43.mp3": {
   "ja": "そろそろ怒りますよ",
   "zh": "我要生气了哦"
  },
  "azusa-44.mp3": {
   "ja": "けいおん大好き！です",
   "zh": "最喜欢轻音了！"
  },
  "azusa-45.mp3": {
   "ja": "うひっ",
   "zh": "唔嘻"
  },
  "azusa-46.mp3": {
   "ja": "ふっ、なんでもないです！",
   "zh": "噗，没什么！"
  },
  "azusa-47.mp3": {
   "ja": "時間どにゃん",
   "zh": "到时间喵"
  }
 }
