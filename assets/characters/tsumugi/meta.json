 "lines": {
  "tumugi-24.mp3": {
   "ja": "うふふふ",
   "zh": "呵呵呵"
  },
  "tumugi-25.mp3": {
   "ja": "どんと来いです！",
   "zh": "放马过来！"
  },
  "tumugi-26.mp3": {
   "ja": "どんどこ来たです！",
   "zh": "接二连三地来啦！"
  },
  "tumugi-27.mp3": {
   "ja": "どてち？",
   "zh": "什么呀？"
  },
  "tumugi-28.mp3": {
   "ja": "どすこーい！！",
   "zh": "嘿——！（相扑登场）"
  },
  "tumugi-29.mp3": {
   "ja": "あらよっと！",
   "zh": "嘿咻！"
  },
  "tumugi-30.mp3": {
   "ja": "お茶入りましたよ！",
   "zh": "茶泡好啦！"
  },
  "tumugi-31.mp3": {
   "ja": "アイス…",
   "zh": "冰淇淋…"
  },
  "tumugi-32.mp3": {
   "ja": "あら、やだ！",
   "zh": "哎呀，讨厌！"
  },
  "tumugi-33.mp3": {
   "ja": "楽しいです。嬉しいです。",
   "zh": "好开心。好高兴。"
  },
  "tumugi-34.mp3": {
   "ja": "好き？",
   "zh": "喜欢吗？"
  },
  "tumugi-35.mp3": {
   "ja": "軽音大好き！",
   "zh": "最喜欢轻音了！"
  },
  "tumugi-36.mp3": {
   "ja": "今日のお菓子は何でしょう？",
   "zh": "今天会有什么点心呢？"
  },
  "tumugi-37.mp3": {
   "ja": "うふふふふ",
   "zh": "呵呵呵呵"
  },
  "tumugi-38.mp3": {
   "ja": "どんどこいです！",
   "zh": "放马过来！"
  },
  "tumugi-39.mp3": {
   "ja": "イェース！",
   "zh": "耶——！"
  },
  "tumugi-40.mp3": {
   "ja": "ムギって呼ばれてます",
   "zh": "大家都叫我䌷"
  },
  "tumugi-41.mp3": {
   "ja": "キーボード担当です",
   "zh": "我是键盘手"
  },
  "tumugi-42.mp3": {
   "ja": "ぽっ",
   "zh": "噗"
  },
  "tumugi-43.mp3": {
   "ja": "あはははは！楽しい！",
   "zh": "啊哈哈！好开心！"
  },
  "tumugi-44.mp3": {
   "ja": "うふふふふ！もっともっとー！",
   "zh": "呵呵呵呵！再来再来～！"
  },
  "tumugi-45.mp3": {
   "ja": "（含糊）",
   "zh": "要不要来点炸薯条～"
  },
  "tumugi-46.mp3": {
   "ja": "お出かけですか？どこに行きますか？",
   "zh": "要出门吗？要去哪里？"
  },
  "tumugi-47.mp3": {
   "ja": "あっ",
   "zh": "啊"
  },
  "tumugi-48.mp3": {
   "ja": "どんと来いです！",
   "zh": "放马过来！"
  },
  "tumugi-49.mp3": {
   "ja": "やったー！恥ずかしいです！",
   "zh": "太好了！好害羞！"
  },
  "tumugi-50.mp3": {
   "ja": "時間ですよ！",
   "zh": "到时间啦！"
  }
 }
