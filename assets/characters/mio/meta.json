 "lines": {
  "mio-24.mp3": {
   "ja": "ひゃあ！",
   "zh": "呀啊！"
  },
  "mio-25.mp3": {
   "ja": "がくがく",
   "zh": "抖、抖…（发抖）"
  },
  "mio-26.mp3": {
   "ja": "チーン",
   "zh": "叮——（无语）"
  },
  "mio-27.mp3": {
   "ja": "ゴーン",
   "zh": "咚——（钟声）"
  },
  "mio-28.mp3": {
   "ja": "ひぃーーー！！",
   "zh": "咿——！！"
  },
  "mio-29.mp3": {
   "ja": "なんだかクラクラするよ",
   "zh": "头好晕啊…"
  },
  "mio-30.mp3": {
   "ja": "もういい！やめろ！",
   "zh": "够了！住手！"
  },
  "mio-31.mp3": {
   "ja": "やめろって言ってるのに",
   "zh": "我都说住手了…"
  },
  "mio-32.mp3": {
   "ja": "また会おうね！",
   "zh": "下次再见哦！"
  },
  "mio-33.mp3": {
   "ja": "もう知らない！",
   "zh": "我不管了！"
  },
  "mio-34.mp3": {
   "ja": "リツ、助けて！",
   "zh": "律，救我！"
  },
  "mio-35.mp3": {
   "ja": "ごめん",
   "zh": "对不起"
  },
  "mio-36.mp3": {
   "ja": "なんか、楽しくなってきた！",
   "zh": "好像…开始开心起来了！"
  },
  "mio-37.mp3": {
   "ja": "あはははは！",
   "zh": "啊哈哈哈！"
  },
  "mio-38.mp3": {
   "ja": "やめろ、リツ！",
   "zh": "住手，律！"
  },
  "mio-39.mp3": {
   "ja": "ひゅー、ドロドロドロ",
   "zh": "咻——咚隆隆隆"
  },
  "mio-40.mp3": {
   "ja": "澪でーす！",
   "zh": "我是澪——！"
  },
  "mio-41.mp3": {
   "ja": "今日は練習するぞ！",
   "zh": "今天要好好练习！"
  },
  "mio-42.mp3": {
   "ja": "もう好きにして",
   "zh": "随你便吧…"
  },
  "mio-43.mp3": {
   "ja": "おい！みんな！",
   "zh": "喂！大家！"
  },
  "mio-44.mp3": {
   "ja": "りつー！りつー！",
   "zh": "律——！律——！"
  },
  "mio-45.mp3": {
   "ja": "（含糊）",
   "zh": "唔…"
  },
  "mio-46.mp3": {
   "ja": "ここは天国ですか？",
   "zh": "这里是天国吗？"
  },
  "mio-47.mp3": {
   "ja": "けいおん、大好き！",
   "zh": "最喜欢轻音了！"
  },
  "mio-48.mp3": {
   "ja": "楽しいかも",
   "zh": "好像挺开心的"
  },
  "mio-49.mp3": {
   "ja": "恥ずかしい",
   "zh": "好害羞"
  },
  "mio-50.mp3": {
   "ja": "時間です",
   "zh": "到时间了"
  }
 }
