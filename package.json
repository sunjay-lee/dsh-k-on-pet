{
  "name": "dsh-k-on-pet",
  "version": "1.0.0",
  "description": "《轻音少女》五位角色的 DSH Web 桌宠：任意方位走动、待机/点击/双击动作、茶桌与自动回位，素材取自原版 Windows 桌宠。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test test/core.test.mjs",
    "test": "npm run build && node scripts/check.mjs && node --test test/core.test.mjs",
    "prepublishOnly": "npm run build && node scripts/check.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "k-on",
    "keion",
    "desktop-pet",
    "mascot",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "dsh-k-on-pet contributors",
  "icon": "assets/icon.png"
}
